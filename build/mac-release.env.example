# Copy to a local file (not committed) and `source` it before `npm run dist:mac`.
# Example:  cp build/mac-release.env.example .env.mac && $EDITOR .env.mac && set -a && source .env.mac && set +a

# --- Code signing (Developer ID Application) ---
# Option A: certificate already in your login keychain (recommended on your Mac)
#   Leave CSC_* unset; electron-builder will pick "Developer ID Application: …"
# Option B: export a .p12 and point to it:
# CSC_LINK=/absolute/path/to/Certificates.p12
# CSC_KEY_PASSWORD=your-p12-password
#
# Optional explicit identity (otherwise auto-discovered):
# CSC_NAME=Developer ID Application: Your Name (TEAMID)

# --- Notarization (pick ONE auth method) ---

# Method 1 — Apple ID + app-specific password
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=ABCDE12345

# Method 2 — App Store Connect API key (recommended for CI)
# APPLE_API_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# APPLE_API_KEY_ID=XXXXXXXXXX
# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_TEAM_ID=ABCDE12345
